# Copy to .env (gitignored) before `docker compose -f docker-compose.hub.yml up`.
# Path to the atlas-inventory repo. Relative paths are from this directory
# (the folder that contains the compose file), not from the shell cwd.
# Sibling checkout next to atlas-ui: ../atlas-inventory
# Compose mounts
#   $ATLAS_INVENTORY/clusters  → /atlas/clusters
#   $ATLAS_INVENTORY/workspace → /atlas/workspace
# Leave Project Settings inventory/workspace empty so hub uses /atlas/….
# SSH for clusterctl: System / Secrets Manager. Do not set SSH_KEY.

ATLAS_INVENTORY=../atlas-inventory

# Optional: host checkout of atlas-clusterctl. Unset = <compose project dir>/atlas-clusterctl
# ATLAS_CLUSTER_ROOT=/home/you/git/atlas-clusterctl

# Optional: pin published images. Unset = latest
# ATLAS_UI_IMAGE_TAG=latest

# Optional: override the first admin password (CI). Unset = admin / admin
# with a forced password change after first login.
# ATLAS_ADMIN_PASSWORD=

# Optional: persist across hosts. If unset, hub writes data/auth/jwt_secret
# and data/auth/encryption_key once (mode 0600).
# JWT_SECRET_KEY=
# GLOBAL_SECRETS_ENCRYPTION_KEY=
