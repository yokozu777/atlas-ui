# Copy to .env (gitignored) before `docker compose up`.
# Absolute host paths — bind-mounted at the same path inside hub/worker.

ATLAS_CLUSTER_ROOT=/home/you/git/atlas-clusterctl
ATLAS_CLUSTERS_ROOT=/home/you/git/atlas-inventory/clusters
ATLAS_WORKSPACE_ROOT=/home/you/git/atlas-inventory/workspace
SSH_KEY=/home/you/.ssh/id_rsa

# Hub API URL for the Next.js console (BFF). Fallback: STARGATE_API_URL.
HUB_API_URL=http://127.0.0.1:8000

# Optional: skip first-run password file (CI / known lab password).
# If unset, hub writes data/auth/admin-initial.txt (mode 0600).
# ATLAS_ADMIN_PASSWORD=

# Optional: persist across hosts. If unset, hub/start.sh writes data/auth/jwt_secret
# and data/auth/encryption_key once (mode 0600).
# JWT_SECRET_KEY=
# GLOBAL_SECRETS_ENCRYPTION_KEY=
