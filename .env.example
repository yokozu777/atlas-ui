# Copy to .env (gitignored) before `docker compose up`.
# These are HOST paths (Linux /home, macOS /Users, Windows C:\Users\…).
# Compose bind-mounts them at /atlas/clusterctl, /atlas/clusters,
# /atlas/workspace, and /atlas/ssh/id_rsa inside hub/worker.
# clusterctl starts krang via /var/run/docker.sock using those host sources.

# Public atlas-clusterctl source (Settings → Clone / Pull).
ATLAS_CLUSTERCTL_GIT_URL=https://github.com/yokozu777/atlas-clusterctl.git

# Checkout directory on the host. Unset = <compose project dir>/atlas-clusterctl
# (the folder you ran `docker compose` from). Do not put a Git URL here.
# ATLAS_CLUSTER_ROOT=/home/you/atlas-ui/atlas-clusterctl

ATLAS_CLUSTERS_ROOT=/home/you/git/atlas-inventory/clusters
ATLAS_WORKSPACE_ROOT=/home/you/git/atlas-inventory/workspace
SSH_KEY=/home/you/.ssh/id_rsa

# Worker → hub (compose network). Unset = http://hub:8000
# Linux host-network override only: WORKER_SERVER_URL=http://127.0.0.1:8000
# WORKER_SERVER_URL=http://hub:8000

# Optional: skip first-run password file (CI / known lab password).
# If unset, hub writes data/auth/admin-initial.txt (mode 0600).
# ATLAS_ADMIN_PASSWORD=

# Optional: persist across hosts. If unset, hub/start.sh writes data/auth/jwt_secret
# and data/auth/encryption_key once (mode 0600).
# JWT_SECRET_KEY=
# GLOBAL_SECRETS_ENCRYPTION_KEY=
