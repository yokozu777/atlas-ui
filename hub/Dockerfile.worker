# Hub worker
# Build context: atlas-ui repo root
# docker-cli talks to the host daemon via /var/run/docker.sock (sibling
# krang container for execution.mode=docker). Not docker.io: that package
# is dockerd, and Debian's split does not ship /usr/bin/docker.
FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client \
    ansible \
    sshpass \
    bash \
    git \
    ca-certificates \
    docker-cli \
    net-tools \
    iputils-ping \
    python3-passlib \
    && rm -rf /var/lib/apt/lists/*

COPY hub/worker/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY hub/clusterctl_config.py /app/clusterctl_config.py
COPY hub/worker /app/worker

RUN mkdir -p /app/data

ENV PYTHONPATH=/app
ENV DATA_DIR=/app/data
ENV WORKER_SERVER_URL=http://hub:8000

CMD ["python", "-m", "worker.main", "--poll-interval", "5", "--max-concurrency", "1"]
